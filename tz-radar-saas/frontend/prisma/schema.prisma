generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(CLIENT)
  client    ClientProfile?
  createdAt DateTime @default(now()) @map("created_at")
  
  @@map("users")
}

enum Role {
  ADMIN
  CLIENT
}

model ClientProfile {
  id              String         @id @default(uuid())
  userId          String         @unique @map("user_id")
  user            User           @relation(fields: [userId], references: [id])
  companyName     String         @map("company_name")
  customKeywords  String[]       @map("custom_keywords")
  alertWebhookUrl String?        @map("alert_webhook_url")
  reports         RadarReport[]
  actionItems     ActionItem[]
  createdAt       DateTime       @default(now()) @map("created_at")
  
  @@map("client_profiles")
}

model RadarReport {
  id                   String         @id @default(uuid())
  clientId             String         @map("client_id")
  client               ClientProfile  @relation(fields: [clientId], references: [id])
  reportDate           DateTime       @default(now()) @map("report_date")
  executiveSummary     String         @db.Text @map("executive_summary")
  
  // Metrics for Dashboard Gauges & Charts
  marketReadinessScore Int            @default(80) @map("market_readiness_score")
  dailyMentions        Int            @default(0) @map("daily_mentions")
  sentimentScore       Float          @default(0.5) @map("sentiment_score")
  
  chinaInsights        Json           @map("china_insights")
  russiaInsights       Json           @map("russia_insights")
  crisisAlerts         Json           @map("crisis_alerts")
  status               ReportStatus   @default(COMPLETED)
  posts                ScrapedPost[]
  actionItems          ActionItem[]
  
  @@map("radar_reports")
}

enum ReportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model ActionItem {
  id          String        @id @default(uuid())
  clientId    String        @map("client_id")
  client      ClientProfile @relation(fields: [clientId], references: [id])
  reportId    String?       @map("report_id")
  report      RadarReport?  @relation(fields: [reportId], references: [id])
  title       String
  description String        @db.Text
  status      ActionStatus  @default(NEW)
  dueDate     DateTime?     @map("due_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  
  @@map("action_items")
}

enum ActionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

// -- Phase 4: Enhanced Post Model with Rich Metadata --
model ScrapedPost {
  id                  String     @id @default(uuid())
  reportId            String?    @map("report_id")
  report              RadarReport? @relation(fields: [reportId], references: [id])
  
  // Source
  platform            String
  author              String
  authorFollowers     Int        @default(0) @map("author_followers")
  isInfluencer        Boolean    @default(false) @map("is_influencer")
  contentOriginal     String     @db.Text @map("content_original")
  contentTranslated   String?    @db.Text @map("content_translated")
  url                 String
  publishedAt         DateTime?  @map("published_at")
  screenshotUrl       String?    @map("screenshot_url")
  
  // Engagement
  likes               Int        @default(0)
  comments            Int        @default(0)
  shares              Int        @default(0)
  views               Int        @default(0)
  engagementScore     Float      @default(0) @map("engagement_score")
  
  // Analysis
  sentiment           String     @default("neutral")
  isCrisis            Boolean    @default(false) @map("is_crisis")
  topics              String[]
  language            String     @default("unknown")
  sourceKeyword       String?    @map("source_keyword")
  
  // Actions
  flagged             Boolean    @default(false)
  archived            Boolean    @default(false)
  actionTaken         String?    @map("action_taken")
  actionTakenAt       DateTime?  @map("action_taken_at")
  
  // Metadata
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  
  @@index([platform, publishedAt])
  @@index([isCrisis])
  @@index([topics])
  @@map("scraped_posts")
}